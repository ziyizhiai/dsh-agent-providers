{
  "name": "dsh-agent-providers",
  "version": "0.1.0",
  "description": "Expose third-party coding agents (OpenCode, Claude Code, Codex, TRAE CLI, any ACP agent) as DeepSeek Harness model-provider groups, with session management",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "docs/transport-contract.md",
    "docs/RECOVERY_WORKFLOW.md",
    "docs/RELIABILITY_UPGRADE.md",
    "docs/INTERACTION_UPGRADE.md",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "llm",
    "provider",
    "acp",
    "agent",
    "opencode",
    "claude-code",
    "codex",
    "trae",
    "traex"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test:package": "node scripts/package-smoke.mjs",
    "test:recovery": "node --test test/recovery.test.mjs",
    "test:reliability": "node --test test/reliability.test.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node --test test/client.test.mjs",
    "test:improvements": "node --test test/improvements.test.mjs",
    "probe:ui": "node probe/probe-ui.mjs",
    "probe:host": "node probe/probe-host-smoke.mjs",
    "link": "node scripts/link-dsh.mjs",
    "probe:acp": "node probe/probe-acp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyizhiai/dsh-agent-providers.git"
  },
  "homepage": "https://github.com/ziyizhiai/dsh-agent-providers#readme",
  "bugs": {
    "url": "https://github.com/ziyizhiai/dsh-agent-providers/issues"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "author": "ziyizhiai"
}
